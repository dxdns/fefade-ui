{
	"name": "@fefade-ui/vue",
	"version": "0.0.1",
	"description": "Reusable Vue UI components powered by the fefade-ui core system.",
	"private": false,
	"author": "fefade <https://github.com/fefade>",
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT",
	"homepage": "https://ui.fefade.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fefade/ui.git"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"build:watch": "vue-tsc -b --watch & vite build --watch",
		"lint": "run-s lint:*",
		"lint:oxlint": "oxlint . --fix",
		"lint:eslint": "eslint . --fix --cache",
		"format": "prettier --write --experimental-cli src/"
	},
	"peerDependencies": {
		"@fefade-ui/core": "^0.0.1"
	},
	"devDependencies": {
		"@fefade-ui/core": "*",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vue/eslint-config-typescript": "^14.6.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-oxlint": "~1.42.0",
		"eslint-plugin-vue": "^10.3.0",
		"glob": "^11.0.3",
		"npm-run-all": "^4.1.5",
		"oxlint": "~1.42.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vite-plugin-dts": "^4.5.4",
		"vite-plugin-lib-inject-css": "^2.2.2",
		"vue": "^3.5.17",
		"vue-tsc": "^2.2.12"
	},
	"keywords": [
		"vue",
		"vue-ui",
		"ui",
		"fefade-ui",
		"components",
		"ui-components",
		"vue-pkg",
		"dxdns",
		"kit"
	]
}
