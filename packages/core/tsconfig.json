{
	"compilerOptions": {
		"target": "ES2020",
		"module": "node16",
		"moduleResolution": "node16",
		"types": ["node"],
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"declarationDir": "dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"incremental": true,
		"tsBuildInfoFile": ".tsbuildinfo"
	},
	"include": ["src"],
	"exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts"]
}
