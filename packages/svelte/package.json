{
	"name": "@fefade-ui/svelte",
	"version": "0.0.6",
	"description": "Reusable Svelte UI components powered by the fefade ui core system.",
	"private": false,
	"author": "fefade <https://github.com/fefade>",
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT",
	"homepage": "https://ui.fefade.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fefade/ui.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@fefade-ui/core": ">=0.0.6",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@fefade-ui/core": "*",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"publint": "^0.3.17",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"svelte-ui",
		"ui",
		"fefade",
		"components",
		"ui-components",
		"svelte-pkg",
		"svelte-actions",
		"actions",
		"kit"
	]
}
