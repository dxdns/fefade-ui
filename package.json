{
	"name": "ui",
	"description": "A flexible UI library for modern web development.",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/**"
	],
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"prepare": "pnpm -r build",
		"ci:publish": "pnpm publish -r --access public --no-git-checks",
		"dev:core": "pnpm --filter @fefade-ui/core run dev",
		"dev:docs": "pnpm --filter docs run dev",
		"dev:svelte": "concurrently --names \"CORE,SVELTE\" --prefix-colors \"gray,yellow\" \"pnpm run dev:core\" \"pnpm --filter @fefade-ui/svelte run dev\"",
		"dev": "concurrently --names \"CORE,DOCS\" --prefix-colors \"gray,white\" \"pnpm run dev:core\" \"pnpm run dev:docs\"",
		"build:core": "pnpm --filter @fefade-ui/core run build",
		"build:svelte": "pnpm --filter @fefade-ui/svelte run build",
		"format": "prettier --write .",
		"clean:build": "find . -type d \\( -name 'build' -o -name 'dist' \\) -prune -exec rm -rf '{}' +",
		"clean:modules": "find . -type d -name 'node_modules' -prune -exec rm -rf '{}' +",
		"clean:lock": "find . -type f -name 'pnpm-lock.yaml' -exec rm -f '{}' +",
		"clean": "pnpm run clean:modules && pnpm run clean:lock && pnpm clean:build"
	},
	"devDependencies": {
		"@changesets/cli": "^2.30.0",
		"@types/node": "^22.19.15",
		"concurrently": "^9.2.1",
		"glob": "^13.0.6",
		"globals": "^17.4.0",
		"jiti": "^2.6.1",
		"prettier": "^3.8.1",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-svelte": "^3.5.1",
		"typescript": "^5.9.3"
	}
}
